{
  "name": "@clock-ui/vue",
  "version": "0.2.0",
  "description": "Vue components for Clock UI, providing reactive clock widgets built with Vue 3 and Composition API.",
  "keywords": [
    "clock",
    "analog-clock",
    "analog",
    "time",
    "timezone",
    "component",
    "ui",
    "css",
    "typescript",
    "zero-dependency",
    "vue",
    "vue3",
    "vue-component",
    "composition-api"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://clock-ui.github.io/clock-ui/",
  "bugs": {
    "url": "https://github.com/clock-ui/clock-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clock-ui/clock-ui.git",
    "directory": "packages/vue"
  },
  "author": "Robert Latamaosadi <robert.latamaosadi@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./base.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@clock-ui/styles": "workspace:*",
    "@clock-ui/utils": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "vue": "^3.5.42",
    "vue-tsc": "^3.1.3"
  }
}
