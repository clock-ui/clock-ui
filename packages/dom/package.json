{
  "name": "@clock-ui/dom",
  "version": "0.2.0",
  "description": "Vanilla DOM-based clock components with built-in rendering and styling support.",
  "keywords": [
    "clock",
    "analog-clock",
    "analog",
    "time",
    "timezone",
    "component",
    "ui",
    "css",
    "typescript",
    "zero-dependency",
    "vanilla",
    "dom",
    "umd",
    "svelte",
    "solid",
    "angular",
    "web-components",
    "custom-elements"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://clock-ui.github.io/clock-ui/",
  "bugs": {
    "url": "https://github.com/clock-ui/clock-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clock-ui/clock-ui.git",
    "directory": "packages/dom"
  },
  "author": "Robert Latamaosadi <robert.latamaosadi@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/element.*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./element": {
      "types": "./dist/element.d.mts",
      "default": "./dist/element.mjs"
    },
    "./base.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@clock-ui/styles": "workspace:*",
    "@clock-ui/utils": "workspace:*"
  }
}
