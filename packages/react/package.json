{
  "name": "@clock-ui/react",
  "version": "0.2.0",
  "description": "React components for Clock UI, providing live and static clock widgets built with React and hooks for reactive time updates.",
  "keywords": [
    "clock",
    "analog-clock",
    "analog",
    "time",
    "timezone",
    "component",
    "ui",
    "css",
    "typescript",
    "zero-dependency",
    "react",
    "react-component",
    "hooks"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://clock-ui.github.io/clock-ui/",
  "bugs": {
    "url": "https://github.com/clock-ui/clock-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clock-ui/clock-ui.git",
    "directory": "packages/react"
  },
  "author": "Robert Latamaosadi <robert.latamaosadi@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./base.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite --config playground/vite.config.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@clock-ui/styles": "workspace:*",
    "@clock-ui/utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tsconfig/strictest": "^2.0.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "classnames": "^2.5.1"
  }
}
