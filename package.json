{
  "name": "clock-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docs:build": "turbo run build --filter=docs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "example:react": "turbo run dev --filter=@clock-ui/example-react",
    "example:vue": "turbo run dev --filter=@clock-ui/example-vue",
    "example:vanilla": "turbo run dev --filter=@clock-ui/example-vanilla",
    "example:svelte": "turbo run dev --filter=@clock-ui/example-svelte",
    "example:solid": "turbo run dev --filter=@clock-ui/example-solid",
    "example:astro": "turbo run dev --filter=@clock-ui/example-astro",
    "smoke": "bun run --cwd examples/vanilla build && node scripts/smoke-examples.mjs",
    "version:packages": "changeset version"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "overrides": {
    "vue": "^3.5.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.1",
    "bumpp": "^12.3.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "unplugin-lightningcss": "^0.5.0",
    "vite": "npm:rolldown-vite@^7.2.2",
    "vitest": "^5.0.0"
  }
}
